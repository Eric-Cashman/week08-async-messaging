{
  "name": "order-fulfillment-async",
  "version": "1.0.0",
  "private": true,
  "description": "Decoupled order fulfillment: Express REST ingestion + RabbitMQ + background worker + Redis status store",
  "scripts": {
    "dev:api": "tsx src/api.ts",
    "dev:worker": "tsx src/worker.ts",
    "build": "tsc",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "amqplib": "^0.10.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
